NODE_ENV=development
PORT=4000
MONGODB_URI=mongodb://localhost:27017/blessings
JWT_ACCESS_SECRET=change-me-access-min-32-chars-long!!
JWT_REFRESH_SECRET=change-me-refresh-min-32-chars-long!
# Leave empty for Vercel -> Railway proxy auth. A Railway cookie domain breaks Safari.
COOKIE_DOMAIN=
CLIENT_URL=http://localhost:8080
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Must match the authorized redirect URI in Google Cloud Console.
# Keep this on the API host. The app then exchanges a one-time token on the site origin so cookies stick.
GOOGLE_CALLBACK_URL=http://localhost:4000/api/auth/google/callback
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
# Live production: rzp_live_… + that key's secret + the live webhook secret.
# Never commit secrets. Never send Key Secret or Webhook Secret to the browser.
# Dashboard (Live): webhook URL https://your-domain/api/webhook/razorpay
# Events: payment.captured, payment.failed, refund.processed, refund.failed
# HTTPS site URL must match CLIENT_URL. Missing any secret → fail closed (no Checkout, no paid mark).
ADMIN_SEED_EMAIL=admin@blessings.com
ADMIN_SEED_PASSWORD=ChangeMe123!
ADMIN_SEED_NAME=Admin
# Optional: override image folder for seed (default: src/assets or server/seed-assets)
# SEED_ASSETS_DIR=../seed-assets
# After adding images to src/assets, run: npm run sync-assets (then commit server/seed-assets)

# Order status emails (shipped / out for delivery / delivered / cancel). Optional.
# MAIL_FROM=Blessings <hello@yourdomain.com>
# RESEND_API_KEY=
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
